[Unit]
Description=vmbackupd virtual machine backup daemon
Documentation=file:///usr/share/doc/vmbackupd/packaging.md
Requires=vmbackupd-storage-helper.socket
After=local-fs.target systemd-tmpfiles-setup.service libvirtd.service virtqemud.socket vmbackupd-storage-helper.socket

[Service]
Type=simple
User=vmbackupd
Group=vmbackupd
SupplementaryGroups=qemu
ExecStart=/usr/bin/vmbackupd --config /etc/vmbackupd/vmbackupd.toml
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
StateDirectory=vmbackupd
StateDirectoryMode=0750
UMask=0007

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/vmbackupd /var/lib/libvirt/images/vmbackupd /run/vmbackupd

[Install]
WantedBy=multi-user.target
